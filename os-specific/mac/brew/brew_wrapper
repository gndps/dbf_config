
#!/usr/bin/env bash


# Reads the current file and executes `safebrew` on each line
# Usage: execute_brew_packages_file
execute_brew_packages_file() {
    local file_path=$(realpath "${BASH_SOURCE[0]}")
    local packages_file="$(dirname "$file_path")/brew_packages_list"

    while IFS= read -r package || [[ -n "$package" ]]; do
        safebrew "$package"
    done < "$packages_file"
}

# Install a homebrew package with optional `--cask` flag
# Usage: install_brew_command [--cask] <package_name>
# Install package if not already installed
safebrew() {
    # Check for help flag
    if [[ -z "$1" || "$1" == "-h" || "$1" == "--help" ]]; then
        echo "Install a Homebrew package (with optional --cask flag)"
        echo "Usage: safebrew [--cask] <package_name>"
        echo "--------------------------------------"
        echo "Works like: brew install [--cask] <package_name>"
        echo "Only installs if not already installed"
        return 0
    fi

    # Check for more than two arguments
    if [[ $# -gt 2 ]]; then
        echo "Error: Too many arguments. Please provide only one package name."
        return 1
    fi

    # Define variables
    local brew_command=("brew" "install")
    local package_name=""

    # Check if --cask is the first argument
    if [[ "$1" == "--cask" ]]; then
        brew_command+=("--cask")
        package_name="$2"
    else
        package_name="$1"
    fi

    # Determine the list command based on whether it's a cask or formula
    local brew_list_cmd="brew list"
    if [[ "${brew_command[*]}" =~ "--cask" ]]; then
        brew_list_cmd="brew list --cask"
    else
        brew_list_cmd="brew list --formula"
    fi

    # Install the package if not already installed
    if ! eval "$brew_list_cmd | grep -q ^$package_name\$"; then
        "${brew_command[@]}" "$package_name"
    else
        echo "$package_name is already installed."
    fi
}
