[default]
echo "default profile applied 🐶✨✨"
# echo
# echo "default profile doesn't install anything other than cloning and sourcing repos using repos_config.json"
# echo "Profiles initializations allow changing machine specific or os specific behaviour by enabling these features:"
# echo "custom repos_config.json according to machine or os type"
# echo "custom initialization code etc"

[ohmyposh]
source $BASH_FILES_DIR/config/ohmyposh/install_ohmyposh


[mac_dp_local_packages]
source $BASH_FILES_DIR/config/local_source_paths

[brew]
echo "Installing profile brew"
source $BASH_FILES_DIR/config/os-specific/mac/brew/brew_installs
# export BF_REPOS_CONFIG_FILE_OVERWRITE="$BASH_FILES_DIR/config/machine-specific/mac_dp/repos_config.json"

[pipx]
pipx install ranger-fm
pipx install uv

[utils]
npm install -g @builder.io/ai-shell || echo "ai-shell install failed"
# ai config set OPENAI_KEY=<your token>

[mackup_mac]
echo "Restoring Mackup on Mac"
brew install mackup
brew install koekeishiya/formulae/yabai
ln -s ~/.bash_files/repos/mackup/.mackup.cfg ~/.mackup.cfg
mackup restore --force

[mackup_ubuntu]
echo "Restoring Mackup on Ubuntu"
sudo python3 -m pip install mackup
pipx install uv
ln -s ~/.bash_files/repos/mackup/.mackup.cfg ~/.mackup.cfg
mackup restore --force

